#lang racket/base
(require ffi/unsafe "constants.rkt" "types.rkt")
(define (hex2 b)
  (define s (number->string b 16))
  (if (= (string-length s) 1) (string-append "0" s) s))
(define (bf-dump name sz align mem)
  (printf "~a ~a ~a " name sz align)
  (for ([i (in-range sz)]) (display (hex2 (ptr-ref mem _byte i))))
  (newline))
