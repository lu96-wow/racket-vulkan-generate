#lang racket/base
(require vulkan/unsafe ffi/unsafe ffi/unsafe/define)
(define libvk (ffi-lib "libvulkan" '("1" "")))
(define myGetInstanceProcAddr (get-ffi-obj "vkGetInstanceProcAddr" libvk (_fun _pointer _string -> _pointer)))
(define myGetDeviceProcAddr (get-ffi-obj "vkGetDeviceProcAddr" libvk (_fun _pointer _string -> _pointer)))
(define app (make-VkApplicationInfo 'VK_STRUCTURE_TYPE_APPLICATION_INFO #f #f 0 #f 0 VK_API_VERSION_1_1))
(define ici (make-VkInstanceCreateInfo 'VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO #f 0 app 0 #f 0 #f))
(define ip (malloc _VkInstance))
(vkCreateInstance ici #f ip)
(define inst (ptr-ref ip _VkInstance))
(printf "inst ptr=~a  MyGIPA(vkCmdDraw)=~a~%" inst (myGetInstanceProcAddr inst "vkCmdDraw"))
;; physical device + device
(define cnt (malloc _uint32))
(vkEnumeratePhysicalDevices inst cnt #f)
(define arr (malloc (* (ptr-ref cnt _uint32) (ctype-sizeof _VkPhysicalDevice))))
(vkEnumeratePhysicalDevices inst cnt arr)
(define pd (ptr-ref arr _VkPhysicalDevice))
(define qinfo (make-VkDeviceQueueCreateInfo 'VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO #f 0 0 1 (let ([f (malloc _float)]) (ptr-set! f _float 1.0) f)))
(define dinfo (make-VkDeviceCreateInfo 'VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO #f 0 1 qinfo 0 #f 0 #f #f))
(define dp (malloc _VkDevice))
(vkCreateDevice pd dinfo #f dp)
(define dev (ptr-ref dp _VkDevice))
(printf "dev ptr=~a~%" dev)
(for ([n '("vkCmdDraw" "vkCmdBeginRendering" "vkCreateSwapchainKHR" "vkCmdPipelineBarrier2" "vkQueueSubmit")])
  (printf "  GDPA(~a) = ~a   GIPA(inst,~a) = ~a~%" n (myGetDeviceProcAddr dev n) n (myGetInstanceProcAddr inst n)))
(vkDestroyDevice dev #f)
(vkDestroyInstance inst #f)
